<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card. Fill and border come from @color/widget_panel / @color/widget_border,
     which have a values-night override, so the launcher shows a light card in light mode
     and a dark card in dark mode — independent of the mood colour of the dots. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
    <corners android:radius="20dp" />
</shape>
